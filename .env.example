# Green Direct internal pilot environment example.
# Copy values into your shell, service manager, or deployment secret store.
# This file is documentation only; the app does not auto-load .env files.

# Required for 10-20 person internal pilot. When enabled, users must log in
# before entering the six-step Streamlit workflow.
GREEN_DIRECT_ENABLE_PILOT_AUTH=1

# Required for internal pilot. Use a controlled data directory outside the Git
# working tree. Keep this path consistent with `pilot-admin --store-dir`.
GREEN_DIRECT_PILOT_STORE_DIR=D:\GreenDirectPilot\pilot_store

# Required for multi-user deployment. Do not enable the local runtime snapshot
# on servers, shared machines, containers, or reverse-proxy deployments.
GREEN_DIRECT_ENABLE_RUNTIME_SNAPSHOT=0

# Optional. Default is 20 MB. Raise only after checking server memory and upload
# policy with the pilot administrator.
GREEN_DIRECT_MAX_UPLOAD_MB=20

# Optional. Default is 20000 scenarios per technical run. Lower this for small
# servers; set 0 only for trusted local benchmarking or supervised admin runs.
GREEN_DIRECT_MAX_SCENARIOS_PER_RUN=20000

# Optional. Economy V1 keeps all annual cashflow tables at or below this
# scenario count. Above it, the UI still computes all summary/FIRR/NPV metrics
# but retains only selected annual cashflow tables. Set a very large value for
# supervised audit runs that need all cashflow files.
GREEN_DIRECT_ECONOMY_CASHFLOW_RETENTION_THRESHOLD=1000

# Optional. In economy summary-first mode, retain annual cashflow tables for the
# first N scenario IDs so representative downloads remain available immediately.
GREEN_DIRECT_ECONOMY_RETAINED_CASHFLOW_LIMIT=20

# Optional for desktop/packaged local use only. Server deployments should set
# Streamlit host/port in the service command instead.
# GREEN_DIRECT_PORT=8503

# Optional for PNG export environments where Chrome or Edge is not auto-detected.
# BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Docker compose notes:
# - docker-compose.yml defaults GREEN_DIRECT_ENABLE_PILOT_AUTH=1 and
#   GREEN_DIRECT_ENABLE_RUNTIME_SNAPSHOT=0.
# - The pilot store is mounted at /data/pilot_store inside the container.
# - Do not put real passwords or TLS private keys in this file.
